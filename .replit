modules = ["nodejs-24", "python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["R", "cairo", "ffmpeg-full", "freetype", "ghostscript", "gobject-introspection", "gtk3", "gumbo", "harfbuzz", "itk", "jbig2dec", "libarchive", "libjpeg_turbo", "libpng", "libxcrypt", "mupdf", "openjpeg", "pkg-config", "qhull", "rPackages.jsonlite", "rPackages.lmerTest", "swig", "swig4", "tcl", "tk", "unzip", "which", "xcbuild", "xsimd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run preview -- --host 0.0.0.0 --port 5000"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 240000
